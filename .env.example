#-----------------------------------------------------------------------------
# PG School Correspondence — local / campus setup
# SETUP-AND-RUN.bat creates .env for you. Or copy this file to `.env`.
#-----------------------------------------------------------------------------

# XAMPP MySQL (default root, blank password):
DATABASE_URL="mysql://root@127.0.0.1:3306/postgraduate_correspondence"

# Auth (any long random strings are fine for local demo)
AUTH_SECRET="local-dev-auth-secret-change-me-32chars-min"
SIGNATURE_SECRET="local-dev-signature-secret-change-me"
SESSION_MAX_AGE="28800"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PG School Correspondence System"
NEXT_PUBLIC_ORG_NAME="The Postgraduate College, University of Ibadan"

SEED_SUPER_ADMIN_EMAIL="registry.admin@pgcollege.ui.edu.ng"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe!2026"

# Optional email (leave blank for local — reset links print in the terminal)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PG School Registry <no-reply@pgcollege.ui.edu.ng>"
